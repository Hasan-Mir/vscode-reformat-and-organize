{
    "name": "reformat-and-organize",
    "displayName": "Reformat & Organize",
    "description": "Organize imports and format files from the VS Code Explorer. Reformat code for files, folders, multi-selections, Git changed files, or open files in the background.",
    "version": "1.2.0",
    "publisher": "SeyMi",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "author": {
        "name": "SeyMi"
    },
    "maintainers": [
        "SeyMi"
    ],
    "categories": [
        "Formatters",
        "Other"
    ],
    "icon": "media/icon.png",
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "reformatAndOrganize.reformatCode",
                "title": "📐 Reformat Code…",
                "category": "Reformat & Organize"
            },
            {
                "command": "reformatAndOrganize.organizeImports",
                "title": "🧹 Organize Imports…",
                "category": "Reformat & Organize"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "reformatAndOrganize.reformatCode",
                    "group": "7_modification@100"
                },
                {
                    "command": "reformatAndOrganize.organizeImports",
                    "group": "7_modification@101"
                }
            ],
            "editor/context": [
                {
                    "command": "reformatAndOrganize.reformatCode",
                    "group": "1_modification@100"
                },
                {
                    "command": "reformatAndOrganize.organizeImports",
                    "group": "1_modification@101"
                }
            ],
            "editor/title/context": [
                {
                    "command": "reformatAndOrganize.reformatCode",
                    "group": "1_modification@100"
                },
                {
                    "command": "reformatAndOrganize.organizeImports",
                    "group": "1_modification@101"
                }
            ],
            "view/item/context": [
                {
                    "command": "reformatAndOrganize.reformatCode",
                    "when": "view == workbench.explorer.openEditorsView",
                    "group": "7_modification@100"
                },
                {
                    "command": "reformatAndOrganize.organizeImports",
                    "when": "view == workbench.explorer.openEditorsView",
                    "group": "7_modification@101"
                }
            ]
        },
        "configuration": {
            "title": "Reformat & Organize",
            "properties": {
                "reformatAndOrganize.include": {
                    "type": "string",
                    "default": "*.ts, *.tsx, *.js, *.jsx, *.mjs, *.cjs, *.vue, *.json, *.jsonc, *.css, *.scss, *.less, *.html",
                    "markdownDescription": "Default **file mask(s)** used by the scope dialog (comma-separated, WebStorm style). Supports `*`, `?` and `**`. A mask containing `/` is matched against the workspace-relative path; otherwise against the file name. Leave empty to include every file."
                },
                "reformatAndOrganize.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/out/**",
                        "**/build/**",
                        "**/coverage/**",
                        "**/.next/**",
                        "**/*.min.*"
                    ],
                    "markdownDescription": "Glob patterns that are always skipped, even when a folder is right-clicked directly."
                },
                "reformatAndOrganize.showDialog": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show the WebStorm-like scope dialog (options + file mask) before running. When disabled, the commands run immediately using `#orgfmt.include#`, `#orgfmt.exclude#` and `#orgfmt.organizeImportsDuringFormat#`."
                },
                "reformatAndOrganize.organizeImportsDuringFormat": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Default state of the **Optimize imports** checkbox in the *Format Files Here* dialog (like WebStorm's Reformat Code dialog). The two commands stay separate; this only lets formatting *optionally* organize imports too."
                },
                "reformatAndOrganize.saveAfterEdit": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Save each file after it has been processed in the background. When disabled, changed files are left dirty (open in memory) so you can review them."
                },
                "reformatAndOrganize.organizeImportsTimeout": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "markdownDescription": "Maximum time in **milliseconds** to wait for the language server (tsserver) to load and analyze a background-opened file before running **Organize Imports** on it.\n\nBy default (`0`) the extension waits **as long as it takes** — the moment the server produces usable code actions, processing continues, no matter how big the project is.\n\nSet a positive value to cap the wait per file (useful if some files are outside any TypeScript project and would otherwise wait forever); the progress notification's cancel button always aborts the wait."
                }
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Hasan-Mir/vscode-reformat-and-organize"
    },
    "bugs": {
        "url": "https://github.com/Hasan-Mir/vscode-reformat-and-organize/issues"
    },
    "scripts": {
        "build": "tsc -p ./",
        "package": "npm run build && vsce package",
        "checktype": "tsc --noEmit",
        "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
    },
    "devDependencies": {
        "@types/node": "^24.x",
        "@types/vscode": "1.85.0",
        "@vscode/vsce": "^3.x",
        "typescript": "^5.x"
    },
    "keywords": [
        "reformat and organize",
        "organize imports and format files",
        "organize imports",
        "format files",
        "reformat code",
        "optimize imports",
        "format folder",
        "folder formatter",
        "bulk format",
        "batch formatting",
        "background formatting",
        "changed files",
        "git changed files",
        "open files",
        "explorer context menu",
        "webstorm",
        "webstorm reformat code",
        "typescript imports",
        "javascript imports",
        "prettier",
        "eslint",
        "code actions"
    ]
}
